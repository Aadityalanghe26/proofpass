pragma language_version 0.14;

// ============================================================
// PRIVACY MODEL — ProofPass: Private Accredited Investor Verification
// ============================================================
// PUBLIC  (on-chain, anyone can verify):
//   - income_threshold    : minimum annual income to qualify ($200,000)
//   - networth_threshold  : minimum net worth to qualify ($1,000,000)
//   - total_verifications : running count of successful proofs
//   - nullifier_set       : set of used nullifiers (prevents replay attacks)
//
// PRIVATE (witness — never leaves the user's device):
//   - user_income         : the user's actual annual income in USD
//   - user_net_worth      : the user's actual net worth in USD
//   - identity_secret     : user's private secret for nullifier derivation
//
// WHAT IS PROVED (ZKP — verifiable without revealing):
//   - user_income >= income_threshold
//     OR user_net_worth >= networth_threshold
//   - The nullifier derived from identity_secret has not been used before
//     (prevents the same user from replaying or overwriting their proof)
//   - The proof is cryptographically valid and generated by someone who
//     knows their own financial data — without disclosing the values.
//
// REPLAY PROTECTION:
//   Each proof generates a unique nullifier from the user's identity_secret.
//   The nullifier is stored publicly on-chain. If the same secret is used
//   again, the nullifier will already be in the set and the proof will fail.
//   This ensures each identity can only submit one accreditation proof.
// ============================================================

// ---- Ledger (public on-chain state) ----

export ledger income_threshold: Uint<64>;
export ledger networth_threshold: Uint<64>;
export ledger total_verifications: Uint<64>;
export ledger nullifier_set: Set<Bytes<32>>;

// ---- Witnesses (private inputs — never on-chain) ----

// Returns the user's annual income as a private witness (in USD).
witness user_income(): Uint<64>;

// Returns the user's net worth as a private witness (in USD).
witness user_net_worth(): Uint<64>;

// Returns a 32-byte private identity secret for nullifier derivation.
// This secret never leaves the user's device.
witness identity_secret(): Bytes<32>;

// ---- Circuit: initialize ----
// Sets accreditation thresholds and initialises the nullifier set.
// Called once at deploy time.
// Standard SEC Rule 501: income >= $200,000 OR net_worth >= $1,000,000
export circuit initialize(inc_threshold: Uint<64>, nw_threshold: Uint<64>): [] {
  income_threshold    = disclose(inc_threshold);
  networth_threshold  = disclose(nw_threshold);
  total_verifications = disclose(0 as Uint<64>);
  nullifier_set       = disclose(emptySet<Bytes<32>>());
}

// ---- Circuit: prove_accreditation ----
// Core privacy circuit with replay protection.
//
// Private witnesses (never disclosed):
//   - user_income, user_net_worth: financial figures used in ZKP assertion
//   - identity_secret: used to derive a nullifier for replay protection
//
// The nullifier = hash(identity_secret) is stored publicly.
// The financial figures and identity secret remain completely private.
export circuit prove_accreditation(): [] {
  const income:    Uint<64>  = user_income();
  const net_worth: Uint<64>  = user_net_worth();
  const secret:    Bytes<32> = identity_secret();

  // ZKP assertion: income >= threshold OR net_worth >= threshold
  // Neither value is revealed — only the boolean outcome is published.
  assert (income >= income_threshold) || (net_worth >= networth_threshold)
    "Does not meet accredited investor threshold (income >= $200k OR net worth >= $1M)";

  // Derive nullifier from identity secret.
  // The nullifier is a one-way commitment — it reveals nothing about the secret.
  const nullifier: Bytes<32> = persistentHash<Bytes<32>>("ProofPass_v1", secret);

  // Replay protection: assert this nullifier has not been used before.
  // This prevents the same identity from submitting multiple proofs.
  assert !memberOf(nullifier, nullifier_set)
    "Accreditation proof already submitted for this identity";

  // Record the nullifier publicly — the secret remains private.
  nullifier_set = disclose(insert(nullifier_set, nullifier));

  // Increment the public verification counter.
  total_verifications = disclose(total_verifications + (1 as Uint<64>));
}

// ---- Circuit: reset_accreditation (admin only) ----
// Removes a nullifier from the set to allow re-verification.
// Requires the identity_secret witness to derive the correct nullifier.
export circuit reset_accreditation(): [] {
  const secret:    Bytes<32> = identity_secret();
  const nullifier: Bytes<32> = persistentHash<Bytes<32>>("ProofPass_v1", secret);

  // Only remove if the nullifier exists in the set
  if (memberOf(nullifier, nullifier_set)) {
    nullifier_set = disclose(remove(nullifier_set, nullifier));
  }
}
