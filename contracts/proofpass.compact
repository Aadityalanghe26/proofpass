pragma language_version 0.14;

// ============================================================
// PRIVACY MODEL — ProofPass: Private Accredited Investor Verification
// ============================================================
// PUBLIC  (on-chain, anyone can verify):
//   - income_threshold    : minimum annual income to qualify ($200,000)
//   - networth_threshold  : minimum net worth to qualify ($1,000,000)
//   - total_verifications : running count of successful proofs
//   - is_accredited       : boolean result of the last verification
//
// PRIVATE (witness — never leaves the user's device):
//   - user_income         : the user's actual annual income in USD
//   - user_net_worth      : the user's actual net worth in USD
//
// WHAT IS PROVED (ZKP — verifiable without revealing):
//   - user_income >= income_threshold
//     OR user_net_worth >= networth_threshold
//   The proof is cryptographically valid and was generated by someone
//   who knows their own financial data — without disclosing the values.
// ============================================================

// ---- Ledger (public on-chain state) ----

export ledger income_threshold: Uint<64>;
export ledger networth_threshold: Uint<64>;
export ledger total_verifications: Uint<64>;
export ledger is_accredited: Boolean;

// ---- Witnesses (private inputs — never on-chain) ----

// Returns the user's annual income as a private witness (in USD, no decimals).
witness user_income(): Uint<64>;

// Returns the user's net worth as a private witness (in USD, no decimals).
witness user_net_worth(): Uint<64>;

// ---- Circuit: initialize ----
// Sets the accreditation thresholds. Called once at deploy time.
// Standard SEC Rule 501 thresholds: income >= $200,000 OR net_worth >= $1,000,000
// Thresholds are configurable at deploy time for international jurisdictions.
export circuit initialize(inc_threshold: Uint<64>, nw_threshold: Uint<64>): [] {
  income_threshold    = disclose(inc_threshold);
  networth_threshold  = disclose(nw_threshold);
  total_verifications = disclose(0 as Uint<64>);
  is_accredited       = disclose(false);
}

// ---- Circuit: prove_accreditation ----
// The core privacy circuit.
// Both user_income and user_net_worth are obtained via private witnesses.
// We only assert the condition — the values themselves are NEVER disclosed.
export circuit prove_accreditation(): [] {
  const income:    Uint<64> = user_income();
  const net_worth: Uint<64> = user_net_worth();

  // ZKP assertion: income >= threshold OR net_worth >= threshold
  // This is the standard SEC Rule 501 accredited investor definition.
  // NEITHER value is ever revealed — only the boolean outcome.
  assert (income >= income_threshold) || (net_worth >= networth_threshold)
    "Does not meet accredited investor threshold (income >= $200k OR net worth >= $1M)";

  // Only the boolean outcome is made public — not income or net worth.
  is_accredited = disclose(true);

  // Increment the public verification counter.
  total_verifications = disclose(total_verifications + (1 as Uint<64>));
}

// ---- Circuit: reset_accreditation ----
// Resets the accreditation flag for a new session.
export circuit reset_accreditation(): [] {
  is_accredited = disclose(false);
}
